Source: "SPI_LCD.asm"
                        	     1: ; Program for outline of code to do MOSI SPI
                        	     2: 
                        	     3: .cpu 6502
                        	     4: .equ outputKIM, 0x1700 ; variable for address of SPI pins (where output will be sent from), bit 7 is MOSI, bit 6 is SS,
                        	     5: .equ outputSettings, 0x1701 ; variable for address of output settings, where we can set pins to inputs or outputs
                        	     6: 
                        	     7: .equ output, 0x1000 ; variable for address of output (for byte_send)
                        	     8: 
                        	     9: .equ byte1, 0x1001 ; variable for address of display address byte
                        	    10: .equ byte2, 0x1002 ; variable for address of display digit byte 
                        	    11: 
                        	    12: .org 0x0200
                        	    13: 
                        	    14: main:
                        	    15:     ; example code to display a HELLO
                        	    16:     ; data sheet: 
                        	    17: 
00:0200 206302          	    18:     JSR setup
                        	    19: 
                        	    20:     ; setup
                        	    21:     set_up:
                        	    22: 
                        	    23:         ; send data to turn on display
00:0203 A9FE            	    24:         LDA #0xFE
00:0205 207902          	    25:         JSR send_a
00:0208 A941            	    26:         LDA #0x41
00:020A 207902          	    27:         JSR send_a
                        	    28: 
                        	    29:         ; send data to clear screen
00:020D A9FE            	    30:         LDA #0xFE
00:020F 207902          	    31:         JSR send_a
00:0212 A951            	    32:         LDA #0x51
00:0214 207902          	    33:         JSR send_a
                        	    34: 
                        	    35:     ; send data for HELLO
                        	    36:     send:
00:0217 A948            	    37:     LDA #0x48
00:0219 207902          	    38:     JSR send_a
                        	    39: 
00:021C 4C1702          	    40:     JMP send
                        	    41: 
                        	    42:     # 0x1C
                        	    43: 
                        	    44:     
                        	    45: 
                        	    46: 
                        	    47: 
                        	    48: byte_send: ; subroutine to send 8 bits (bit 7 is data, bit 6 is CS/SS, bit 5 is CLK)
                        	    49: 
                        	    50:     set_cs_low:
00:021F AD0017          	    51:         LDA outputKIM
00:0222 29BF            	    52:         AND #0b10111111  ; Pull SS (bit 6) low
00:0224 8D0017          	    53:         STA outputKIM
                        	    54: 
                        	    55:     set_clk_high: ; set the clock low before getting data in pin 7
00:0227 AD0017          	    56:         LDA outputKIM
00:022A 0920            	    57:         ORA #0b00100000   ; Pull CLK (bit 5) high
00:022C 8D0017          	    58:         STA outputKIM
                        	    59:     
                        	    60:     set_counter: ; counter to see how many bits have been sent of byte
00:022F A208            	    61:         LDX #0x08
                        	    62:         
                        	    63:     send_output: ; send byte of data
                        	    64:         
                        	    65:         ; store output bit in outputKIM bit 7
00:0231 AD0010          	    66:         LDA output ; load output into accumulator
00:0234 2980            	    67:         AND #0b10000000 ; AND output so only last bit is recognized
00:0236 0D0017          	    68:         ORA outputKIM ; OR output to what's in 0x1700, nothing is changed except last bit
00:0239 8D0017          	    69:         STA outputKIM ; store result in KIM output bit
                        	    70:         
00:023C 0E0010          	    71:         ASL output ; arithmetic shift left of output1 to move next output1 bit to bit 0
                        	    72:     
                        	    73:     clk_cycle: ; simulate a clock cycle that occurs
                        	    74:                ; data has to be stable before clock rising edge
                        	    75:         
00:023F AD0017          	    76:         LDA outputKIM ;load outputKIM into memory
00:0242 4920            	    77:         EOR #0b00100000 ; Invert SCLK (bit 5)
00:0244 8D0017          	    78:         STA outputKIM ; Store into outputKIM
                        	    79:         
00:0247 AD0017          	    80:         LDA outputKIM ; load outputKIM
00:024A 4920            	    81:         EOR #0b00100000 ; Invert SCLK (bit 5)
00:024C 8D0017          	    82:         STA outputKIM ; Store into outputKIM
                        	    83:         
00:024F AD0017          	    84:         LDA outputKIM ; set final digit of outputKIM to 0 so it is modified correctly on next edge
00:0252 297F            	    85:         AND #0b01111111
00:0254 8D0017          	    86:         STA outputKIM
                        	    87:         
00:0257 CA              	    88:         DEX ; decrement number of bits remaining to be sent
                        	    89:         
00:0258 D0D7            	    90:         BNE send_output ; jump to send_output for next bit
                        	    91: 
                        	    92:     set_cs_high:
00:025A AD0017          	    93:         LDA outputKIM
00:025D 0940            	    94:         ORA #0b01000000  ; Pull SS (bit 6) high
00:025F 8D0017          	    95:         STA outputKIM
                        	    96:         
00:0262 60              	    97:     RTS ; end subroutine
                        	    98: 
                        	    99: setup: ; setup subroutine
                        	   100: 
                        	   101:     clear_decimal_mode:
00:0263 D8              	   102:         CLD
                        	   103:     
                        	   104:     set_initial_output_state: ; set outputKIM to 0x00
00:0264 A900            	   105:         LDA #0x00
00:0266 8D0017          	   106:         STA outputKIM
                        	   107:     
                        	   108:     make_output: ; make port A an output
00:0269 A9FF            	   109:         LDA #0xFF
00:026B 8D0117          	   110:         STA outputSettings
                        	   111:     
                        	   112:     set_low: ; Pull SS low and CLK pin high by ANDing with outputKIM and storing it back
00:026E AD0017          	   113:             LDA outputKIM
00:0271 0920            	   114:             ORA #0b00100000  ; Pull CLK (bit 5) high
00:0273 29BF            	   115:             AND #0b10111111  ; Pull SS (bit 6) low
00:0275 8D0017          	   116:             STA outputKIM
                        	   117:             
00:0278 60              	   118:     RTS
                        	   119: 
                        	   120: send_a:
00:0279 8D0010          	   121:     STA output
00:027C 201F02          	   122:     JSR byte_send
00:027F 60              	   123:     RTS
