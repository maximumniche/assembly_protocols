00: "org0001:200" (200-31E)


Source: "SPI.asm"
                        	     1: ; Program for outline of code to do MOSI SPI
                        	     2: 
                        	     3: .cpu 6502
                        	     4: .equ outputKIM, 0x1700 ; variable for address of SPI pins (where output will be sent from), bit 7 is MOSI, bit 6 is SS,
                        	     5: .equ outputSettings, 0x1701 ; variable for address of output settings, where we can set pins to inputs or outputs
                        	     6: 
                        	     7: .equ output, 0x1000 ; variable for address of output (for byte_send)
                        	     8: 
                        	     9: .equ byte1, 0x1001 ; variable for address of display address byte
                        	    10: .equ byte2, 0x1002 ; variable for address of display digit byte 
                        	    11: 
                        	    12: .org 0x0200
                        	    13: 
                        	    14: main:
                        	    15:     ; example code to display a 1 to the rightmost digit of a MAX7219 7 segment display with SPI
                        	    16:     ; data sheet: https://www.analog.com/media/en/technical-documentation/data-sheets/max7219-max7221.pdf
                        	    17:     ; ideally you would put the setup and sending of address and data bytes in their own subroutines (which are like fu
                        	    18: 
00:0200 20C602          	    19:     JSR setup
00:0203 20DC02          	    20:     JSR initialize
                        	    21: 
                        	    22:     ; send data for number 1 to digit 0 of display in code B decode
                        	    23:     
                        	    24:     ; send bytes to display 0 on digit 7 (Address 0x08 -> data[0])
00:0206 A908            	    25:     LDA #0x08
00:0208 8D0110          	    26:     STA byte1
00:020B A90F            	    27:     LDA #0x0F
00:020D 8D0210          	    28:     STA byte2
                        	    29:     
00:0210 20A302          	    30:     JSR spi_send
                        	    31:     
                        	    32:     ; display 0 on digit 6 (Address 0x07 -> data[1])
00:0213 A907            	    33:     LDA #0x07
00:0215 8D0110          	    34:     STA byte1
00:0218 A90F            	    35:     LDA #0x0F
00:021A 8D0210          	    36:     STA byte2
                        	    37:     
00:021D 20A302          	    38:     JSR spi_send
                        	    39:     
                        	    40:     ; display 0 on digit 5 (Address 0x06 -> data[2])
00:0220 A906            	    41:     LDA #0x06
00:0222 8D0110          	    42:     STA byte1
00:0225 A90F            	    43:     LDA #0x0F
00:0227 8D0210          	    44:     STA byte2
                        	    45:     
00:022A 20A302          	    46:     JSR spi_send
                        	    47:     
                        	    48:     ; display 0 on digit 4 (Address 0x05 -> data[3])
00:022D A905            	    49:     LDA #0x05
00:022F 8D0110          	    50:     STA byte1
00:0232 A90F            	    51:     LDA #0x0F
00:0234 8D0210          	    52:     STA byte2
                        	    53:     
00:0237 20A302          	    54:     JSR spi_send
                        	    55:     
                        	    56:     ; display 0 on digit 3 (Address 0x04 -> data[4])
00:023A A904            	    57:     LDA #0x04
00:023C 8D0110          	    58:     STA byte1
00:023F A90F            	    59:     LDA #0x0F
00:0241 8D0210          	    60:     STA byte2
                        	    61:     
00:0244 20A302          	    62:     JSR spi_send
                        	    63:     
                        	    64:     ; display 0 on digit 2 (Address 0x03 -> data[5])
00:0247 A903            	    65:     LDA #0x03
00:0249 8D0110          	    66:     STA byte1
00:024C A90F            	    67:     LDA #0x0F
00:024E 8D0210          	    68:     STA byte2
                        	    69:     
00:0251 20A302          	    70:     JSR spi_send
                        	    71:     
                        	    72:     ; display 0 on digit 1 (Address 0x02 -> data[6])
00:0254 A902            	    73:     LDA #0x02
00:0256 8D0110          	    74:     STA byte1
00:0259 A90F            	    75:     LDA #0x0F
00:025B 8D0210          	    76:     STA byte2
                        	    77:     
00:025E 20A302          	    78:     JSR spi_send
                        	    79:     
                        	    80:     ; display 1 on digit 0 (Address 0x01 -> data[7])
00:0261 A901            	    81:     LDA #0x01
00:0263 8D0110          	    82:     STA byte1
00:0266 A901            	    83:     LDA #0x01
00:0268 8D0210          	    84:     STA byte2
                        	    85:     
00:026B 20A302          	    86:     JSR spi_send
