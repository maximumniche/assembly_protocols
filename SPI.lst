                        	    92: 
                        	    93: byte_send: ; subroutine to send 8 bits
                        	    94: 
                        	    95:     set_clk_low: ; set the clock low before getting data in pin 7
00:026F AD0017          	    96:         LDA outputKIM
00:0272 29DF            	    97:         AND #0b11011111   ; Pull CLK (bit 5) low
00:0274 8D0017          	    98:         STA outputKIM
                        	    99:     
                        	   100:     set_counter: ; counter to see how many bits have been sent of byte
00:0277 A208            	   101:         LDX #0x08
                        	   102:         
                        	   103:     send_output: ; send byte of data
                        	   104:         
                        	   105:         ; store output bit in outputKIM bit 7
00:0279 AD0010          	   106:         LDA output ; load output into accumulator
00:027C 2980            	   107:         AND #0b10000000 ; AND output so only last bit is recognized
00:027E 0D0017          	   108:         ORA outputKIM ; OR output to what's in 0x1700, nothing is changed except last bit
00:0281 8D0017          	   109:         STA outputKIM ; store result in KIM output bit
                        	   110:         
00:0284 0E0010          	   111:         ASL output ; arithmetic shift left of output1 to move next output1 bit to bit 0
                        	   112:     
                        	   113:     clk_cycle: ; simulate a clock cycle that occurs
                        	   114:                ; data has to be stable before clock rising edge
                        	   115:         
00:0287 AD0017          	   116:         LDA outputKIM ;load outputKIM into memory
00:028A 4920            	   117:         EOR #0b00100000 ; Invert SCLK (bit 5)
00:028C 8D0017          	   118:         STA outputKIM ; Store into outputKIM
                        	   119:         
00:028F AD0017          	   120:         LDA outputKIM ; load outputKIM
00:0292 4920            	   121:         EOR #0b00100000 ; Invert SCLK (bit 5)
00:0294 8D0017          	   122:         STA outputKIM ; Store into outputKIM
                        	   123:         
00:0297 AD0017          	   124:         LDA outputKIM ; set final digit of outputKIM to 0 so it is modified correctly on next edge
00:029A 297F            	   125:         AND #0b01111111
00:029C 8D0017          	   126:         STA outputKIM
                        	   127:         
00:029F CA              	   128:         DEX ; decrement number of bits remaining to be sent
                        	   129:         
00:02A0 D0D7            	   130:         BNE send_output ; jump to send_output for next bit
                        	   131:         
00:02A2 60              	   132:     RTS ; end subroutine
                        	   133: 
                        	   134: 
                        	   135: spi_send: ; subroutine to send 2 bytes for display
                        	   136:     
                        	   137:     ; set SS pin low
                        	   138:     set_ss_low:
00:02A3 AD0017          	   139:         LDA outputKIM
00:02A6 29BF            	   140:         AND #0b10111111 ; Pull SS (bit 6) low
00:02A8 8D0017          	   141:         STA outputKIM
                        	   142:     
                        	   143:     ; send address byte
                        	   144:     send_address:
00:02AB AD0110          	   145:         LDA byte1
00:02AE 8D0010          	   146:         STA output
00:02B1 206F02          	   147:         JSR byte_send
                        	   148:     
                        	   149:     ; send data byte
                        	   150:     send_data:
00:02B4 AD0210          	   151:         LDA byte2
00:02B7 8D0010          	   152:         STA output
00:02BA 206F02          	   153:         JSR byte_send
                        	   154:     
                        	   155:     ; set SS pin high
                        	   156:     set_ss_high:
00:02BD AD0017          	   157:         LDA outputKIM
00:02C0 0940            	   158:         ORA #0b01000000 ; Pull SS (bit 6) high
00:02C2 8D0017          	   159:         STA outputKIM
                        	   160:         
00:02C5 60              	   161:     RTS ; end subroutine
                        	   162:     
                        	   163: setup: ; setup subroutine
                        	   164: 
                        	   165:     clear_decimal_mode:
00:02C6 D8              	   166:         CLD
                        	   167:     
                        	   168:     set_initial_output_state: ; set outputKIM to 0x00
00:02C7 A900            	   169:         LDA #0x00
00:02C9 8D0017          	   170:         STA outputKIM
                        	   171:     
                        	   172:     make_output: ; make port A an output
00:02CC A9FF            	   173:         LDA #0xFF
00:02CE 8D0117          	   174:         STA outputSettings
                        	   175:     
                        	   176:     set_low: ; Pull SS and CLK pin to low by AND with outputKIM and storing it back
00:02D1 AD0017          	   177:             LDA outputKIM
00:02D4 29DF            	   178:             AND #0b11011111  ; Pull CLK (bit 5) low
00:02D6 29BF            	   179:             AND #0b10111111  ; Pull SS (bit 6) low
00:02D8 8D0017          	   180:             STA outputKIM
                        	   181:             
00:02DB 60              	   182:     RTS
                        	   183: 
                        	   184: initialize: ; Initialize MAX7219 subroutine
                        	   185: 
                        	   186:     ; Set Decode Mode to code B (Address 0x09 -> Data 0xFF)
00:02DC A909            	   187:     LDA #0x09
00:02DE 8D0110          	   188:     STA byte1
00:02E1 A9FF            	   189:     LDA #0xFF
00:02E3 8D0210          	   190:     STA byte2
00:02E6 20A302          	   191:     JSR spi_send
                        	   192: 
                        	   193:     ; Set Intensity (Address 0x0A -> Data 0x0F)
00:02E9 A90A            	   194:     LDA #0x0A
00:02EB 8D0110          	   195:     STA byte1
00:02EE A90F            	   196:     LDA #0x0F
00:02F0 8D0210          	   197:     STA byte2
00:02F3 20A302          	   198:     JSR spi_send
                        	   199: 
                        	   200:     ; Set Scan Limit (Address 0x0B -> Data 0x07)
00:02F6 A90B            	   201:     LDA #0x0B
00:02F8 8D0110          	   202:     STA byte1
00:02FB A907            	   203:     LDA #0x07
00:02FD 8D0210          	   204:     STA byte2
00:0300 20A302          	   205:     JSR spi_send
                        	   206: 
                        	   207:     ; Turn on display (Address 0x0C -> Data 0x01)
00:0303 A90C            	   208:     LDA #0x0C
00:0305 8D0110          	   209:     STA byte1
00:0308 A901            	   210:     LDA #0x01
00:030A 8D0210          	   211:     STA byte2
00:030D 20A302          	   212:     JSR spi_send
                        	   213: 
                        	   214:     ; Exit Display Test Mode (Address 0x0F -> Data 0x00)
00:0310 A90F            	   215:     LDA #0x0F
00:0312 8D0110          	   216:     STA byte1
00:0315 A900            	   217:     LDA #0x00
00:0317 8D0210          	   218:     STA byte2
00:031A 20A302          	   219:     JSR spi_send
                        	   220:     
00:031D 60              	   221:     RTS ; end subroutine
